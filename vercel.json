{
  "functions": {
    "app/api/*/route.ts": {
      "maxDuration": 10
    }
  },
  "regions": ["bom1"],
  "buildCommand": "pnpm build",
  "headers": [
    {
      "source": "/api/upload",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
